@import "~/.config/theme/colors/rofi.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1180px;
    height:                      710px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    border-radius:               15px;
    cursor:                      "default";
    background-color:            @background;
}

mainbox {
    background-color: transparent;
    children:         [ imagebox ];
    spacing:          0px;
    padding:          0px;
}

imagebox {
    padding:                     20px;
    width:                       500px;
    background-color:            @background;
    orientation:                 vertical;
    children:                    [ inputbar, message,listview ];
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               10px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:         [ prompt, textbox-prompt-colon, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @selected;
    font:             "JetBrains Mono Bold 11";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @foreground;
    expand:           false;
    str:              " ›";
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Search Wallpaper...";
    placeholder-color: @foreground;
}

message {
    background-color: @background;
    border:           0px 0px 1px 0px;
    border-color:     @background;
    padding:          4px 14px;
    foreground:       @foreground;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrains Mono 9";
}


/*------------------------------------------*/
listview { 
    background-color: @background;
    columns: 4; 
    lines: 3; 
    spacing: 5px; 
    border-radius:    10px;
    padding: 8px; 
    fixed-height: true; 
    scrollbar: false; 
    flow: horizontal; 
}

element {
    orientation:        vertical; 
    spacing:            0px; 
    padding:            2px; 
    border:             2px solid; 
    border-color:       @background-alt; 
    border-radius:      40px; 
    background-color:   @background-alt;
    expand:             true;
}

element selected { 
    border:             6px solid;
    border-color:       @selected;
    border-radius:      40px;
    background-color:   @background-alt;
    padding:            0px;
}

element-icon { 
    size:               272px; 
    padding:            0px;
    border-radius:      40px;
    background-color:   transparent;
}

element-text {
    font:               "JetBrains Mono 1";
    text-color:         transparent;
    background-color:   transparent; 
    padding:            0px; 
    size:               0px;
    expand:             false;
}

scrollbar {
    background-color: @background;
    handle-color:     @selected;
    handle-width:     4px;
    border-radius:    0px;
    width:            6px;
}